# Backend runtime example for the standard StiGPT stack.
# Docker is started from ../frontent with:
# docker compose -p stigpt up -d --build

# Host-exposed Docker ports:
# - backend API: 32101
# - postgres: 32113
# - redis: 32114
# - admin portal: 32111
# - player app: 32112

# Database
DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:32113/game_ai_cs?schema=public"

# JWT
JWT_SECRET="replace-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="1h"

# Redis
REDIS_URL="redis://localhost:32114"
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_MAX_RECONNECT_ATTEMPTS=5
REDIS_RETRY_DELAY_BASE=200
REDIS_RETRY_DELAY_MAX=2000
REDIS_CONNECT_TIMEOUT=5000
REDIS_PING_TIMEOUT=2000
METRICS_KEY="change-me"

# Cache
CACHE_ENABLED=true
CACHE_JITTER_PCT=0.1
CACHE_CONFIG_TTL_SECONDS=900
CACHE_QUICK_REPLY_TTL_SECONDS=60
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_SNAPSHOT_TTL_SECONDS=300
DASHBOARD_DEGRADED_TTL_SECONDS=300
DASHBOARD_DEGRADE_EVENT_LOOP_MS=200
DASHBOARD_DEGRADE_CPU_LOAD_RATIO=1.2
DASHBOARD_DEGRADE_QUERY_MS=1500
DASHBOARD_DEGRADED=false

# Server
PORT=21101
NODE_ENV="development"

# Logging
LOG_LEVEL="INFO"
LOG_SAMPLING_RATE="0.1"
LOG_BATCH_SIZE=100
LOG_BATCH_INTERVAL=100
LOG_MAX_QUEUE_SIZE=10000
LOG_ENABLE_COMPRESSION=true
LOG_ARCHIVE_AFTER_DAYS=7
LOG_CLEAN_AFTER_DAYS=30
LOG_USE_REDIS_BUFFER=false
LOG_REDIS_KEY=system:logs:buffer
LOG_REDIS_MAX_SIZE=10000

# Frontend origins
FRONTEND_URL="http://localhost:32111,http://localhost:32112,http://127.0.0.1:32111,http://127.0.0.1:32112,http://localhost:20101,http://localhost:20102,http://127.0.0.1:20101,http://127.0.0.1:20102"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Dify
DIFY_API_KEY=replace-with-dify-api-key
DIFY_BASE_URL=http://your-dify-server/v1

# Baidu translate
BAIDU_TRANSLATE_APP_ID=replace-with-baidu-app-id
BAIDU_TRANSLATE_SECRET=replace-with-baidu-secret

# WebSocket
WS_HEARTBEAT_CHECK_INTERVAL=15000
WS_HEARTBEAT_MAX_MISSED=3
WS_HEARTBEAT_PING_TIMEOUT=15000
WS_STATE_TTL=86400
WS_PLAYER_RATE_LIMIT=200
WS_AGENT_RATE_LIMIT=600
WS_PLAYER_BURST=20
WS_AGENT_BURST=60
WS_RATE_LIMIT_NOTICE_COOLDOWN=1000

# Queue
QUEUE_RETRY_DELAY_BASE=1000
QUEUE_RETRY_DELAY_MAX=4000
QUEUE_MAX_RETRIES=3

# Throttle
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=200
THROTTLE_DIFY_TTL=60000
THROTTLE_DIFY_LIMIT=100
THROTTLE_SESSION_TTL=60000
THROTTLE_SESSION_LIMIT=1000
THROTTLE_TICKET_TTL=60000
THROTTLE_TICKET_LIMIT=1000

# Security
ENCRYPTION_SECRET_KEY="replace-with-32-char-encryption-key"
ENCRYPTION_SALT="replace-with-unique-salt"
DIFY_DEFAULT_LIMIT=20

# Ticket auto close
ENABLE_AUTO_CLOSURE=true
WAITING_TIMEOUT_HOURS=72
REPLIED_TIMEOUT_HOURS=24

# Aliyun
ALIYUN_API_KEY="replace-with-aliyun-api-key"
ALIYUN_ACCESS_KEY_ID="replace-with-aliyun-access-key-id"
ALIYUN_ACCESS_KEY_SECRET="replace-with-aliyun-access-key-secret"
ALIYUN_NLS_APP_KEY="replace-with-nls-app-key"
ALIYUN_LLM_MODEL="qwen-turbo"
ALIYUN_LLM_TEMPERATURE=0.3
ALIYUN_LLM_MAX_TOKENS=1500
ALIYUN_EMBEDDING_MODEL="text-embedding-v2"
ALIYUN_EMBEDDING_DIMENSION=1536
ALIYUN_TTS_VOICE="xiaoyun"
ALIYUN_TTS_FORMAT="mp3"
ALIYUN_TTS_SAMPLE_RATE=16000

# Milvus
MILVUS_HOST="localhost"
MILVUS_PORT=32115
MILVUS_USERNAME=""
MILVUS_PASSWORD=""
MILVUS_DATABASE="default"

# Documents
DOCUMENT_QUEUE_CONCURRENCY=2
DOCUMENT_PROCESSING_TIMEOUT=300000
MAX_DOCUMENT_SIZE=52428800
SUPPORTED_DOCUMENT_TYPES="pdf,md"
